# انسخ الملف ده باسم .env وغيّر القيم

# باسورد لوحة التحكم (اختار باسورد قوي)
ADMIN_PASSWORD=change-me-strong-password

# كلام عشوائي طويل لتأمين تسجيل الدخول
# تقدر تعمله بالأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# اسم المتجر ولينكه (بيظهروا في صفحة التتبع)
STORE_NAME=متجري
STORE_URL=https://mystore.com

PORT=3000

# رابط داتابيس Supabase:
# Supabase ← مشروعك ← زرار Connect ← Connection string ← اختار "Session pooler"
# انسخ الرابط وحط الباسورد بتاع الداتابيس مكان [YOUR-PASSWORD]
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# (اختياري/تجريبي) لاستقبال الطلبات أوتوماتيك من EasyOrders
# WEBHOOK_SECRET=

# على السيرفر الحقيقي خليها production
# NODE_ENV=production
